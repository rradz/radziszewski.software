---
import '../styles/global.css';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';

interface Props {
	title?: string;
	description?: string;
	layout?: 'columns';
}

const { title, description = site.description, layout } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname;
const hasPosts = (await getPosts()).length > 0;

const nav = [
	{ href: '/apps/', label: 'Apps' },
	{ href: '/consulting/', label: 'Consulting' },
	{ href: '/about/', label: 'About' },
	...(hasPosts ? [{ href: '/blog/', label: 'Blog' }] : []),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{pageTitle}</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={new URL(path, Astro.site)}>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		{hasPosts && <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml">}
	</head>
	<body>
		<header>
			<a href="/"><span>Radziszewski</span> <span>Software</span></a>
			<nav>
				{nav.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
			</nav>
		</header>
		<main class={layout}>
			<slot />
		</main>
		<footer>
			<p>© {new Date().getFullYear()} {site.name} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
			<p>This page uses no cookies.</p>
		</footer>
	</body>
</html>

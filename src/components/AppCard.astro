---
import type { App } from '../data/apps';

interface Props {
	app: App;
}

const { app } = Astro.props;
---

<a class="app" href={`/apps/${app.slug}/`}>
	<img src={app.icon} alt="" width="64" height="64" />
	<span>
		<strong>{app.name}</strong>
		<span class="muted">{app.tagline}</span>
		<span class="status">{app.appStoreUrl ? 'iPhone · App Store' : 'iPhone · coming soon'}</span>
	</span>
</a>

<style>
	.app {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		text-decoration: none;
		transition: border-color 0.15s;
	}

	.app:hover {
		border-color: var(--accent);
	}

	img {
		flex: none;
		border-radius: 22.5%;
	}

	.app > span {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.status {
		margin-top: 0.25rem;
		font: 0.75rem/1.4 var(--mono);
		color: var(--muted);
	}
</style>

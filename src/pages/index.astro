---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base layout="columns">
	<h1>{site.description}</h1>

	<section>
		<h2>Apps</h2>
		<p>An ongoing experiment: what is left of an app when it does one thing, and nothing else?</p>
		<p><a href="/apps/">More about the apps</a></p>
	</section>

	<section>
		<h2>Consulting</h2>
		<p>Distributed systems, new products and architecture review, by the day.</p>
		<p><a href="/consulting/">More about consulting</a></p>
	</section>

	<section>
		<h2>Contact</h2>
		<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
	</section>
</Base>

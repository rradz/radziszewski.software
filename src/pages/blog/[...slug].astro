---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
	return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
	<article>
		<h1>{post.data.title}</h1>
		<p><small><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></small></p>
		<Content />
	</article>
</Base>

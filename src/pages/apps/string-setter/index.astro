---
import Base from '../../../layouts/Base.astro';
import { apps } from '../../../data/apps';

const app = apps.find((a) => a.slug === 'string-setter')!;

const shots = [
	['1-tighter', 'Standard tuning with the G string selected and flat: Tighter lights up.'],
	['2-in-tune', 'The low E string in tune: the note is green.'],
	['3-wrong-octave', 'Drop D with the low D selected while the D string is played: the screen shows Hearing D3.'],
	['4-chromatic', 'The chromatic tuner naming the note played.'],
];
---

<Base title={app.name} description="Tuning made obvious. Tap a peg, pluck the string and turn it the way the screen says, however far out of tune it starts.">
	<h1>{app.name}</h1>
	<p>
		<img src="/apps/string-setter/icon-b8.png" alt="" width="96" height="96">
	</p>
	<p>String Setter makes tuning a guitar obvious, even if you’ve never done it before.</p>
	<p>
		The screen is laid out like your guitar’s headstock, with each peg where it sits on the guitar, so you always know
		which one you’re turning. Tap a peg and the string lights up from that peg to the sound hole. Pluck it and the
		screen tells you which way to turn: tighter or looser. When the string is in tune, the note turns green and your
		phone taps once.
	</p>
	<p>
		Every string is tuned to its exact pitch, so however far out of tune it starts, the screen knows which way you
		need to turn and keeps telling you, tighter or looser, until you’re there. If what you play is far from the
		target, it shows which note it actually hears.
	</p>
	<p>
		{app.appStoreUrl ? <a href={app.appStoreUrl}>Get it on the App Store</a> : 'Coming soon to the App Store.'}
		<small>iPhone, iOS 26.</small>
	</p>

	<ul role="list">
		{
			shots.map(([file, alt]) => (
				<li>
					<img src={`/apps/string-setter/${file}-b8.jpg`} alt={alt} width="480" height="1044" loading="lazy">
				</li>
			))
		}
	</ul>

	<h2>Details</h2>
	<dl>
		<dt>Tunings</dt>
		<dd>Standard, half and full step down, Drop D and C, Open E, D and G, and DADGAD.</dd>
		<dt>Chromatic</dt>
		<dd>For anything else, tap the bridge for a standard chromatic tuner that names any note you play.</dd>
		<dt>Privacy</dt>
		<dd>Sound is analysed on your phone as it arrives. Nothing is recorded or sent anywhere.</dd>
	</dl>

	<p><a href="/apps/string-setter/support/">Support</a> · <a href="/apps/string-setter/privacy/">Privacy policy</a></p>
</Base>

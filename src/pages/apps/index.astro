---
import Base from '../../layouts/Base.astro';
import { apps } from '../../data/apps';
---

<Base title="Apps" description="An ongoing project exploring design through deliberately small apps.">
	<h1>Delightful software</h1>
	<p>
		Most apps grow until their feature lists read like manuals, and get harder to use with every release. This is an
		ongoing project that goes the other way: exploring design by making apps that are small on purpose.
	</p>
	<p>
		Each one does a single job, and the work goes into doing that job well rather than into doing more. The
		guiding idea is Dieter Rams’s: less, but better. They are paid for once, with no subscriptions and no tracking.
	</p>

	<h2>Apps</h2>
	<ul>
		{apps.map((app) => <li><a href={`/apps/${app.slug}/`}>{app.name}</a> — {app.tagline}</li>)}
	</ul>
</Base>

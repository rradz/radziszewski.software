---
import Base from '../../../layouts/Base.astro';
import { apps } from '../../../data/apps';

const app = apps.find((a) => a.slug === 'watch-setter')!;

const shots = [
	['1-main', 'The main screen: countdown, time to set, date, day, month, year, GMT hour and moon phase.'],
	['2-now', 'The countdown reaching zero.'],
	['3-gmt-zone', 'Choosing the zone for the GMT hand.'],
	['4-quickset', 'The warning shown while the date wheel is engaged.'],
];
---

<Base title={app.name} description="One screen for setting a mechanical watch: when to push the crown in, what to set, and every calendar, GMT and moon-phase value.">
	<h1>{app.name}</h1>
	<p>
		<img src="/apps/watch-setter/icon.png" alt="" width="96" height="96">
	</p>
	<p>
		One screen for setting a mechanical watch. It counts down to the next minute, tells you what to set the hands
		to, and gives the date, day, month, year, GMT hour and moon-phase clicks your watch needs. Open it, set the
		watch, close it.
	</p>
	<p>
		{app.appStoreUrl ? <a href={app.appStoreUrl}>Get it on the App Store</a> : 'Coming soon to the App Store.'}
		<small>iPhone, iOS 26.</small>
	</p>

	<ul role="list">
		{
			shots.map(([file, alt]) => (
				<li>
					<img src={`/apps/watch-setter/${file}.jpg`} alt={alt} width="480" height="1044" loading="lazy">
				</li>
			))
		}
	</ul>

	<h2>Details</h2>
	<dl>
		<dt>Countdown</dt>
		<dd>Light taps on the last three seconds, a buzz and a tick at zero. The clock is checked against Apple’s time server.</dd>
		<dt>Calendar, GMT and moon</dt>
		<dd>Date, day, month and year; the hour on a 24-hour scale in any zone; how many clicks to advance the moon disc, for either hemisphere.</dd>
		<dt>Date quickset warning</dt>
		<dd>Tells you when the date wheel is engaged, between 9 PM and 3 AM, and quicksetting could damage the movement.</dd>
		<dt>Nothing collected</dt>
		<dd>No accounts, no analytics, no ads.</dd>
	</dl>

	<p><a href="/apps/watch-setter/support/">Support</a> · <a href="/apps/watch-setter/privacy/">Privacy policy</a></p>
</Base>
